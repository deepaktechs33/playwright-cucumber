# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is gitignored -- it's never committed, so this file is what documents
# which variables the framework reads and what each one means.

# ---- Execution environment ----
EXECUTION_ENV=local
#EXECUTION_ENV=remote

# ---- OS (only relevant if you wire up a remote/grid connection) ----
OS=mac
#OS=windows
#OS=linux

# ---- Browser ----
BROWSER=chrome
#BROWSER=edge
#BROWSER=firefox
#BROWSER=webkit

# ---- Headless mode ----
# true  = run browser headless (recommended for CI)
# false = run browser headed/visible (for local debugging)
HEADLESS=true

# ---- Application URL ----
# Required -- no fallback. Point this at whichever environment you're testing.
APP_URL=https://www.saucedemo.com/

# ---- Debug helpers (leave at 0 for CI) ----
# Milliseconds of artificial delay between Playwright actions.
SLOW_MO=400
# Milliseconds to keep the browser open after a scenario finishes, so you can
# see its final state before it closes. Jenkinsfile forces this to 0 on CI.
HOLD_MS=5000

# ---- Screenshot capture ----
# false (default) = only capture a screenshot when a scenario fails
# true             = also capture one after every passing "Then" step
#                     (useful for audit trails, but grows screenshots/ fast)
CAPTURE_STEP_SCREENSHOTS=false
