{
  "name": "saucedemo-playwright-cucumber",
  "version": "1.0.0",
  "private": true,
  "description": "SauceDemo Playwright + Cucumber (TypeScript) ",
  "scripts": {
    "install:browsers": "playwright install --with-deps chromium firefox",
    "test": "cucumber-js",
    "test:login": "cucumber-js features/login.feature",
    "test:sort": "cucumber-js features/sort.feature",
    "test:hamburger": "cucumber-js features/hamberger.feature",
    "test:footer": "cucumber-js features/footer.feature",
    "test:e2e": "cucumber-js features/endtoendflow.feature",
    "allure:generate": "allure generate ./allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.1.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "allure-commandline": "^2.32.0",
    "allure-cucumberjs": "^3.1.1",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
